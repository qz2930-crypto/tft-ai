# Copy to .env and fill in. NEVER commit .env. / 复制为 .env 后填写，切勿提交。

# Riot API key from https://developer.riotgames.com (dev key expires every 24h)
# Riot 开发者密钥（开发 key 每 24 小时过期）
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Platform routing (ladder): na1 | euw1 | kr | ...
# 平台路由（用于排行榜接口）
RIOT_PLATFORM=na1

# Regional routing (match data): americas | europe | asia | sea
# 区域路由（用于对局接口）
RIOT_REGION=americas
